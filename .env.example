# Token del bot (BotFather → /newbot o /token)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID donde llegan pedidos y comentarios (tu user id o id de un grupo)
# Tip: escribile al bot y visitá https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-100xxxxxxxxxx  # id del grupo (ej. Stackd_bot)

# Username del bot sin @
TELEGRAM_BOT_USERNAME=ADVAULTCL_BOT
VITE_TELEGRAM_BOT_USERNAME=ADVAULTCL_BOT

# Opcional: URL pública del API si el front y el API están separados
# VITE_API_URL=https://tu-dominio.com

PORT=8787
