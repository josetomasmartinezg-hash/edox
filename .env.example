# Token del bot (BotFather → /newbot o /token)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat ID del grupo de confirmaciones (ej. Stackd_bot).
# Usá comillas si es negativo (Node --env-file las necesita).
TELEGRAM_CHAT_ID="-1004366279680"

# Opcional: chats extra (IDs privados) que también reciben cada compra
# TELEGRAM_NOTIFY_EXTRA=123456789,987654321

# Username del bot sin @
TELEGRAM_BOT_USERNAME=ADVAULTCL_BOT
VITE_TELEGRAM_BOT_USERNAME=ADVAULTCL_BOT

# Telegram de consultas (humano)
VITE_TELEGRAM_SUPPORT=Stackd2026

# Wallets USDT reales (obligatorio para cobrar)
VITE_USDT_TRC20=TSbh8JPcucyd7yQS6Z1KzhutWh1xS7cbBc
VITE_USDT_BEP20=0xc71aAd54208553E3d1F6e7865Ba9181C72797941
# QRs en public/qr-usdt-trc20.png y public/qr-usdt-bep20.png

# PayPal
VITE_PAYPAL_ME=tuusuario
VITE_PAYPAL_EMAIL=pagos@tudominio.com

# Opcional: URL pública del API si el front y el API están separados
# En producción con dominio propio normalmente NO hace falta (mismo origen).
# VITE_API_URL=https://www.stackdbm.com

# Disco persistente en hosting (Render/Railway). Local: dejalo vacío.
# DATA_DIR=/var/data

# Panel admin (/admin) — cambialo en producción
ADMIN_PASSWORD=stackd-admin

PORT=8787
